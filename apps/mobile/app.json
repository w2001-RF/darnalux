{
  "expo": {
    "name": "DarnaLux",
    "slug": "darnalux",
    "version": "0.1.0",
    "scheme": "darnalux",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": { "supportsTablet": false, "bundleIdentifier": "ma.darnalux.mobile" },
    "android": {
      "package": "ma.darnalux.mobile",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": ["expo-router"]
  }
}
